{
  "name": "gesundheitstracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "start": "vite build && vite preview",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.storage.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "pretest": "npm install --no-audit --no-fund",
    "test": "TZ=Europe/Berlin vitest run",
    "icons": "node scripts/make-icons.ts",
    "publish": "sh scripts/publish.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
